{
  "_comment": "Copy this file to ~/.config/butterfly/butterfly.json. Butterfly reads that file at startup; polish.defaultModel selects the default Smart Polish model.",
  "polish": {
    "defaultModel": "local/foundation",
    "fallback": "rules"
  },
  "provider": {
    "my-provider": {
      "name": "My AI Provider",
      "type": "openai-compatible",
      "options": {
        "baseURL": "$AI_ENDPOINT_BASE_URL",
        "apiKey": "$AI_API_KEY",
        "timeoutMs": 30000
      },
      "models": {
        "example-model": {
          "name": "Example Model"
        }
      }
    }
  }
}
