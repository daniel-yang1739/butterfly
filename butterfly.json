{
  "polish": {
    "defaultModel": "local/foundation",
    "fallback": "rules"
  },
  "provider": {
    "my-provider": {
      "name": "My AI Provider",
      "type": "openai-compatible",
      "options": {
        "baseURL": "$AI_ENDPOINT_BASE_URL",
        "apiKey": "$AI_API_KEY",
        "timeoutMs": 30000
      },
      "models": {
        "<model_code>": {
          "name": "GPT-5.6-luna"
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6-terra",
          "api": "responses",
          "reasoning": true,
          "interleaved": true,
          "defaultVariant": "high",
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          },
          "limit": {
            "context": 512000,
            "output": 65536
          }
        },
        "claude-4.8-opus-aws": {
          "name": "Claude 4.8 Opus"
        },
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash"
        }
      }
    },
  }
}
