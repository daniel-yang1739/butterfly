{
  "polish": {
    "model": "apple/foundation",
    "fallback": "rules"
  },
  "provider": {
    "my-provider": {
      "name": "My AI Provider",
      "type": "openai-compatible",
      "options": {
        "baseURL": "https://ai.example.com/v1",
        "apiKey": "{env:BUTTERFLY_API_KEY}",
        "timeoutMs": 30000
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT-5.6-luna"
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6-terra",
          "api": "responses",
          "reasoning": true,
          "interleaved": true,
          "defaultVariant": "xhigh",
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          },
          "limit": {
            "context": 512000,
            "output": 65536
          }
        },
        "gpt-5.6-luna-aws": {
          "name": "GPT-5.6-luna AWS"
        },
        "gpt-5.6-terra-aws": {
          "name": "GPT-5.6-terra AWS"
        },
        "claude-4.6-sonnet-aws": {
          "name": "Claude 4.6 Sonnet"
        },
        "claude-4.8-opus-aws": {
          "name": "Claude 4.8 Opus"
        },
        "gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro"
        },
        "gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash"
        }
      }
    },
    "ollama": {
      "name": "Ollama",
      "type": "openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeoutMs": 30000
      },
      "models": {
        "gemma4": {
          "name": "Gemma 4"
        }
      }
    }
  }
}
